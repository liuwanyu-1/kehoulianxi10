<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context
       https://www.springframework.org/schema/context/spring-context.xsd">

    <bean id="customer" class="lwy.study.spring.pojo.Customer" scope="prototype">
        <property name="cid" value="3001"/>
        <property name="cname" value="陈晓"/>
        <property name="ctel" value="13800001234"/>
        <property name="caddress" value="合肥市蜀山区大学城商业街"/>
    </bean>
    <context:component-scan base-package="lwy.study.spring.pojo"/>
</beans>
